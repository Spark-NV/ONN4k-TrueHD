<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:custom="http://schemas.android.com/apk/prv/res/com.android.tv.settings" android:title="@*com.android.tv.settings:string/device_display_sound">
    <com.android.tv.twopanelsettings.slices.EmbeddedSlicePreference
        android:title="@*com.android.tv.settings:string/hdmi_cec_settings_title"
        android:key="cec"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/cec_settings_slice_uri"/>
    <PreferenceCategory
        android:title="@*com.android.tv.settings:string/display_category_title"
        android:key="display_category"/>
    <Preference
        android:persistent="true"
        android:title="@*com.android.tv.settings:string/resolution_selection_title"
        android:key="resolution_selection"
        android:fragment="com.android.tv.settings.device.displaysound.ResolutionSelectionFragment"/>
    <Preference
        android:title="@*com.android.tv.settings:string/font_scale_settings_title"
        android:key="font_scale"
        android:fragment="com.android.tv.settings.device.displaysound.FontScalePreferenceFragment"/>
    <com.android.tv.twopanelsettings.slices.EmbeddedSlicePreference
        android:key="hdr_and_color_format"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/hdr_and_color_format_slice_uri"/>
    <SwitchPreference
        android:persistent="true"
        android:title="@*com.android.tv.settings:string/match_content_dynamic_range_title"
        android:key="match_content_dynamic_range"/>
    <Preference
        android:title="@*com.android.tv.settings:string/match_content_frame_rate_title"
        android:key="match_content_frame_rate"
        android:fragment="com.android.tv.settings.device.displaysound.MatchContentFrameRateFragment"/>
    <Preference
        android:title="@*com.android.tv.settings:string/advanced_display_settings_title"
        android:key="advanced_display_settings"
        android:fragment="com.android.tv.settings.device.displaysound.AdvancedDisplayFragment"/>
    <Preference
        android:title="@*com.android.tv.settings:string/picture_settings_title"
        android:key="picture_vendor_settings"
        custom:isPreferenceVisible="false">
        <intent android:action="@*com.android.tv.settings:string/picture_settings_vendor_action"/>
    </Preference>
    <PreferenceCategory
        android:title="@*com.android.tv.settings:string/device_sound"
        android:key="sound_category"/>
    <com.android.tv.twopanelsettings.slices.SlicePreference
        android:title="@*com.android.tv.settings:string/default_audio_output_settings_title"
        android:key="default_audio_output_settings"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/default_audio_output_settings_slice_uri"/>
    <com.android.tv.twopanelsettings.slices.EmbeddedSlicePreference
        android:key="audio_ext"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/audio_ext_uri"/>
    <Preference
        android:title="@*com.android.tv.settings:string/volume_change_settings_title"
        android:key="volume_change"
        android:fragment="com.android.tv.settings.device.displaysound.VolumeChangePreferenceFragment"
        custom:isPreferenceVisible="false"/>
    <Preference
        android:title="@*com.android.tv.settings:string/advanced_sound_settings_title"
        android:key="advanced_sound_settings"
        android:fragment="com.android.tv.settings.device.displaysound.AdvancedVolumeFragment"/>
    <Preference
        android:title="Audio output mode"
        android:key="onn_audio_output_mode"
        android:summary="Passthrough, Dolby DRC, DTS DRC">
        <intent
            android:targetPackage="com.droidlogic.tv.settings"
            android:targetClass="com.droidlogic.tv.settings.SoundActivity"/>
    </Preference>
    <Preference
        android:title="@*com.android.tv.settings:string/sound_settings_title"
        android:key="sound_vendor_settings"
        custom:isPreferenceVisible="false">
        <intent android:action="@*com.android.tv.settings:string/sound_settings_vendor_action"/>
    </Preference>
</PreferenceScreen>
