<?xml version="1.0" encoding="utf-8"?>
<!-- Adds an "Audio output mode" row to Settings > Display & Sound that opens
     onn's sound menu. Not static on purpose: the module turns it on only
     when the Settings app is the build these layouts were copied from. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.onn.truehd.settingsoverlay"
    android:versionCode="2"
    android:versionName="1.1">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />
    <overlay
        android:targetPackage="com.android.tv.settings"
        android:isStatic="false" />
    <application android:hasCode="false" />
</manifest>
